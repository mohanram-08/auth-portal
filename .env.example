# Server port for local development
PORT=3000

# Environment mode: "development" locally, "production" when deployed over HTTPS
NODE_ENV=development

# Secret used to sign session cookies (replace with a long random string)
SESSION_SECRET=replace-this-with-a-long-random-secret-key

# Trusted destination URL after a successful login (REPLACE WITH YOUR WEBSITE)
REDIRECT_URL=https://example.com/dashboard

# SQLite database file path (relative to project root)
DATABASE_PATH=./data/app.db
